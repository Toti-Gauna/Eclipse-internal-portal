# EJEMPLO DUMMY. Copiar a .env SOLO en el backend; nunca a un frontend o public_html.
# Este archivo describe el contrato para el futuro backend; no activa autenticación hoy.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://eclipse_dummy:Dummy_DB_Cambiar_2026@localhost:5432/eclipse?schema=public
# Prisma CLI usa la conexión directa. Localmente puede ser el mismo endpoint.
DATABASE_URL_UNPOOLED=postgresql://eclipse_dummy:Dummy_DB_Cambiar_2026@localhost:5432/eclipse?schema=public
# En Neon: DATABASE_URL lleva -pooler; DATABASE_URL_UNPOOLED no. Copiar ambas
# desde Connect para la rama/base correctas, conservando los parámetros TLS.
SESSION_SECRET=Dummy_Session_Only_Local_Replace_With_Random_64_Hex_Characters
SESSION_COOKIE_NAME=eclipse_session
SESSION_TTL_HOURS=12
SESSION_SECURE=false
INTERNAL_ORIGIN=http://localhost:4173
CLIENT_ORIGIN=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:3001
APP_TIMEZONE=America/Argentina/Buenos_Aires
DEMO_MODE=false

# Crear cuentas una sola vez con un comando administrativo. No recrearlas al arrancar.
# Los emails sirven para iniciar sesión. No se envían correos.
BOOTSTRAP_USERS_JSON='[{"email":"admin@example.invalid","password":"Dummy_Admin_Cambiar_2026!","role":"admin"},{"email":"cliente@example.invalid","password":"Dummy_Cliente_Cambiar_2026!","role":"client","clientId":"cliente-demo"}]'
BOOTSTRAP_REQUIRE_PASSWORD_CHANGE=true

# WhatsApp manual: compartir enlaces wa.me, sin API ni envío automático.
WHATSAPP_MODE=manual
