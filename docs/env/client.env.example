# Configuración PÚBLICA del futuro frontend Next.js de Eclipse-Web.
# Copiar a .env.local en ese repo al implementar el backend.
# NEXT_PUBLIC_* termina en el navegador: nunca incluir credenciales aquí.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_PORTAL_MODE=api
NEXT_PUBLIC_WHATSAPP_MODE=manual
