# Configuración PÚBLICA del futuro frontend interno. No contiene contraseñas.
# El HTML/JS actual no lee .env. El futuro build genera public-config.json desde
# esta lista permitida; el archivo .env NO se copia al artefacto estático.
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
PUBLIC_PORTAL_MODE=api
PUBLIC_CLIENT_PORTAL_URL=http://localhost:3001/es/portal
PUBLIC_WHATSAPP_MODE=manual
